                    "spec": {
                      "format": "table",
                      "rawSql": "SELECT COUNT(*) AS value FROM (SELECT DISTINCT ON (ip, blacklist) ip, blacklist, listed FROM blacklist_checks ORDER BY ip, blacklist, checked_at DESC) latest WHERE listed = true;"
